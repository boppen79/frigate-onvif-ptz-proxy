+                     "settle_until": 0.0}
+            self._absolute_zoom_observations[camera] = state
+        if abs(zoom - state["zoom"]) > 0.01:
+            state["samples"] = []
+            state["zoom"] = zoom
+            state["settle_until"] = frame + 1.5
