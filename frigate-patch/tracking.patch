+def image_velocity(tracked_object: TrackedObject) -> np.ndarray:
+    """Express compensated Kalman velocity in the current image's pixels/frame.
+
+    Transform two positions, not a vector as though it were a position: this
+    cancels translation and handles zoom/perspective at each bbox corner.
+    Invalid transforms stay invalid so the PTZ validity filter can reject them.
+    """
+    velocity = np.asarray(tracked_object.estimate_velocity, dtype=float)
+    if tracked_object.abs_to_rel is None:
+        return velocity.copy()
+    try:
+        position = tracked_object.get_estimate(absolute=True)
+        with np.errstate(divide="ignore", invalid="ignore", over="ignore"):
+            result = (tracked_object.abs_to_rel(position + velocity)
+                      - tracked_object.abs_to_rel(position))
+        return np.asarray(result, dtype=float)
+    except (ValueError, TypeError, np.linalg.LinAlgError):
+        return np.full(velocity.shape, np.nan)
 
 
